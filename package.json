{
  "name": "@signalsandsorcery/timbre-graph",
  "version": "0.1.0",
  "description": "Timbre Graph \u2014 six coordinated Surge XT tracks morphed together through one perceptual control surface. Panel is a stub; the trained motion model lives in training/.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin.json": "./plugin.json"
  },
  "files": [
    "dist",
    "plugin.json",
    "icon.svg",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "signals-and-sorcery",
    "plugin",
    "surge-xt",
    "timbre",
    "sound-design"
  ],
  "author": "Steve Hiehn",
  "license": "MIT",
  "peerDependencies": {
    "@signalsandsorcery/plugin-sdk": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@signalsandsorcery/plugin-sdk": "file:../sas-plugin-sdk",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
